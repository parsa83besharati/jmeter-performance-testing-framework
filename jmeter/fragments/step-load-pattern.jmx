<?xml version="1.0" encoding="UTF-8"?>
<hashTree>
  <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Step Load Pattern">
    <intProp name="ThreadGroup.num_threads">${__P(USERS_START,10)}</intProp>
    <intProp name="ThreadGroup.ramp_time">0</intProp>
    <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
    <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
    <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
      <stringProp name="LoopController.loops">-1</stringProp>
      <boolProp name="LoopController.continue_forever">false</boolProp>
    </elementProp>
  </ThreadGroup>
  <hashTree>
    <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Step Load Controller">
      <stringProp name="cacheKey">true</stringProp>
      <stringProp name="filename"></stringProp>
      <stringProp name="parameters"></stringProp>
      <stringProp name="script">// Step Load Pattern
// Increases users by STEP_SIZE every STEP_INTERVAL seconds
def STEP_SIZE = ${__P(STEP_SIZE,10)}
def STEP_INTERVAL = ${__P(STEP_INTERVAL,60)}  // seconds
def MAX_USERS = ${__P(USERS_MAX,100)}

def ctx = org.apache.jmeter.threads.JMeterContextService.getContext()
def thread = ctx.getThread()
def threadGroup = thread.getThreadGroup()
def currentTime = System.currentTimeMillis() / 1000
def startTime = vars.get("stepLoadStartTime")
if (startTime == null) {
    vars.put("stepLoadStartTime", String.valueOf(currentTime))
    startTime = currentTime
}

def elapsed = currentTime - startTime.toDouble()
def currentThreads = threadGroup.getNumThreads()
def targetThreads = Math.min(USERS_START + (int)(elapsed / STEP_INTERVAL) * STEP_SIZE, MAX_USERS)

if (currentThreads < targetThreads) {
    threadGroup.addThreads(targetThreads - currentThreads)
    log.info("Step Load: Increasing threads from " + currentThreads + " to " + targetThreads)
}</stringProp>
      <stringProp name="scriptLanguage">groovy</stringProp>
    </JSR223Sampler>
    <hashTree/>
    <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Step Interval">
      <stringProp name="ConstantTimer.delay">${__P(STEP_INTERVAL,60)}000</stringProp>
    </ConstantTimer>
    <hashTree/>
  </hashTree>
</hashTree>
